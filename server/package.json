{
  "name": "bphealth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:staging": "prisma migrate deploy && node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:staging-env": "tsx src/checkStagingEnv.ts",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 src/e2e/*.test.ts",
    "test:staging": "tsx --test --test-concurrency=1 src/e2e/stagingApiSmoke.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "prisma": "^6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "undici": "^6.27.0",
    "zod": "^4.4.3"
  }
}
