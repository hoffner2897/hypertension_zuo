# Copy this file to .env and fill in your real values.
# Never commit .env.

PORT=3100

# Local Docker PostgreSQL. Keep this in sync with docker-compose.yml.
DATABASE_URL=postgresql://bphealth:bphealth_dev_password@localhost:5432/bphealth_dev?schema=public

# Use a strong random value outside local development.
ACCESS_TOKEN_SECRET=dev-only-change-me-access-token-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_BASE_URL=http://localhost:3100/auth/verify-email

# Use mock while you are testing the iOS flow without spending API credits.
# Change to "openai" when you want real photo recognition.
BP_RECOGNITION_MODE=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional. Use this only when your terminal/Node process cannot reach OpenAI directly.
# Example for local smart-mode VPN HTTP proxy:
# OPENAI_PROXY_URL=http://127.0.0.1:8118
OPENAI_PROXY_URL=
