# Staging environment template for Render or another hosted API.
# Copy these keys into the hosting provider environment settings.
# Never commit real secrets.

BPHEALTH_ENV=staging
NODE_ENV=production
PORT=3000

# Hosted PostgreSQL, not local Docker.
DATABASE_URL=postgresql://user:password@db.example.com:5432/bphealth_staging?schema=public

# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=replace-with-a-strong-random-value-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_BASE_URL=https://bphealth-api-staging.onrender.com/auth/verify-email

# Use mock for first TestFlight flow testing; change to openai for real photo recognition.
BP_RECOGNITION_MODE=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_ACTION_SUGGESTION_MODEL=gpt-5.6-sol
OPENAI_MEAL_ANALYSIS_MODEL=gpt-5.5
BP_RECOGNITION_DAILY_LIMIT=30
MEAL_ANALYSIS_DAILY_LIMIT=20

OPENAI_PROXY_URL=
