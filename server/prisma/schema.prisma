generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserSex {
  female
  male
  other
  prefer_not_to_say
}

enum BloodPressureReadingSource {
  manual
  camera_mock
  camera_ocr
  health_import
}

enum MealType {
  breakfast
  lunch
  dinner
}

enum AIUsageFeature {
  bp_recognition
  meal_analysis
  bp_interpretation
  action_advice
}

enum ExerciseActionStatus {
  pending
  in_progress
  completed
  skipped
  missed
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  researchEmail   String?   @map("research_email")
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile                 UserProfile?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  bloodPressureReadings   BloodPressureReading[]
  mealRecords             MealRecord[]
  exerciseActions         ExerciseAction[]
  dailyActionSnapshots    DailyActionSnapshot[]
  actionEvents            ActionEvent[]
  aiDailyUsage            AIDailyUsage[]
  aiCostDailyUsage        AICostDailyUsage[]
  actionAdviceCache       ActionAdviceCache?

  @@index([deletedAt])
  @@map("users")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  deviceId  String    @map("device_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  displayName        String    @map("display_name")
  birthYear          Int       @map("birth_year")
  sex                UserSex
  heightCm           Decimal?  @map("height_cm") @db.Decimal(5, 2)
  weightKg           Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  dailySteps         Int?      @map("daily_steps")
  exerciseMinutes    Int?      @map("exercise_minutes")
  restingHeartRate   Int?      @map("resting_heart_rate")
  sleepHours         Decimal?  @map("sleep_hours") @db.Decimal(4, 2)
  healthDataSource   String?   @map("health_data_source")
  healthDataSyncedAt DateTime? @map("health_data_synced_at") @db.Timestamptz(3)
  completedAt        DateTime  @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model BloodPressureReading {
  id         String                     @id @default(uuid()) @db.Uuid
  userId     String                     @map("user_id") @db.Uuid
  clientId   String                     @map("client_id") @db.Uuid
  systolic   Int
  diastolic  Int
  pulse      Int?
  measuredAt DateTime                   @map("measured_at") @db.Timestamptz(3)
  source     BloodPressureReadingSource
  note       String?
  createdAt  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?                  @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, measuredAt])
  @@index([userId, deletedAt])
  @@map("blood_pressure_readings")
}

model MealRecord {
  id                          String   @id @default(uuid()) @db.Uuid
  userId                      String   @map("user_id") @db.Uuid
  mealType                    MealType @map("meal_type")
  mealDate                    String   @map("meal_date") @db.VarChar(10)
  analysis                    String
  similarSuggestion           String   @map("similar_suggestion")
  recognition                 String?  @map("recognition")
  dietaryStructureAnalysis    String?  @map("dietary_structure_analysis")
  cookingMethodAnalysis       String?  @map("cooking_method_analysis")
  dietaryStructureSuggestion  String?  @map("dietary_structure_suggestion")
  cookingMethodSuggestion     String?  @map("cooking_method_suggestion")
  cardSummary                 String   @map("card_summary")
  analysisLocale              String?  @map("analysis_locale") @db.VarChar(16)
  recordedAt                  DateTime @map("recorded_at") @db.Timestamptz(3)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mealDate, mealType])
  @@index([userId, recordedAt])
  @@map("meal_records")
}

model ExerciseAction {
  id               String               @id @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  exerciseId       String               @map("exercise_id") @db.VarChar(100)
  title            String               @db.VarChar(100)
  scene            String               @db.VarChar(80)
  energy           String               @db.VarChar(80)
  contexts         String[]
  scheduledStartAt DateTime             @map("scheduled_start_at") @db.Timestamptz(3)
  durationMinutes  Int                  @map("duration_minutes")
  status           ExerciseActionStatus
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz(3)
  actualStartedAt  DateTime?            @map("actual_started_at") @db.Timestamptz(3)
  timerLastResumedAt DateTime?          @map("timer_last_resumed_at") @db.Timestamptz(3)
  timerAccumulatedSeconds Int           @default(0) @map("timer_accumulated_seconds")
  actualEndedAt    DateTime?            @map("actual_ended_at") @db.Timestamptz(3)
  actualDurationSeconds Int?            @map("actual_duration_seconds")
  completionMode   String?              @map("completion_mode") @db.VarChar(40)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(3)
  movementAdvice   String               @map("movement_advice")
  intensityAdvice  String               @map("intensity_advice")
  localDay         String               @map("local_day") @db.VarChar(10)
  clientUpdatedAt  DateTime             @map("client_updated_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDay, scheduledStartAt])
  @@index([userId, deletedAt])
  @@map("exercise_actions")
}

/// The latest complete representation of one user's Today Action tree for a local day.
/// Images are intentionally excluded; the JSON contains text, timing, status and exercise metadata only.
model DailyActionSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  localDay       String   @map("local_day") @db.VarChar(10)
  timeZone       String   @map("time_zone") @db.VarChar(64)
  version        Int      @default(1)
  items          Json
  totalCount     Int      @map("total_count")
  completedCount Int      @map("completed_count")
  capturedAt     DateTime @map("captured_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDay])
  @@index([localDay, updatedAt])
  @@map("daily_action_snapshots")
}

/// Append-only audit trail derived whenever the iOS client syncs a changed Today Action tree.
/// beforeState/afterState preserve what changed without retaining meal or BP photographs.
model ActionEvent {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  localDay        String    @map("local_day") @db.VarChar(10)
  itemId          String?   @map("item_id") @db.Uuid
  eventType        String    @map("event_type") @db.VarChar(40)
  snapshotVersion Int       @map("snapshot_version")
  beforeState     Json?     @map("before_state")
  afterState      Json?     @map("after_state")
  occurredAt      DateTime  @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDay, occurredAt])
  @@index([userId, itemId, occurredAt])
  @@map("action_events")
}

model AIDailyUsage {
  userId       String         @map("user_id") @db.Uuid
  usageDate    DateTime       @map("usage_date") @db.Date
  feature      AIUsageFeature
  requestCount Int            @default(0) @map("request_count")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, usageDate, feature])
  @@index([usageDate, feature])
  @@map("ai_daily_usage")
}

model AICostDailyUsage {
  userId                String         @map("user_id") @db.Uuid
  usageDate             DateTime       @map("usage_date") @db.Date
  feature               AIUsageFeature
  model                 String         @db.VarChar(80)
  requestCount          Int            @default(0) @map("request_count")
  successCount          Int            @default(0) @map("success_count")
  failureCount          Int            @default(0) @map("failure_count")
  cacheHitCount         Int            @default(0) @map("cache_hit_count")
  inputTokens           BigInt         @default(0) @map("input_tokens")
  cachedInputTokens     BigInt         @default(0) @map("cached_input_tokens")
  outputTokens          BigInt         @default(0) @map("output_tokens")
  reasoningTokens       BigInt         @default(0) @map("reasoning_tokens")
  estimatedCostMicrousd BigInt         @default(0) @map("estimated_cost_microusd")
  lastErrorCode         String?        @map("last_error_code") @db.VarChar(80)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, usageDate, feature, model])
  @@index([usageDate, feature, model])
  @@map("ai_cost_daily_usage")
}

model ActionAdviceCache {
  userId              String   @id @map("user_id") @db.Uuid
  evidenceFingerprint String   @map("evidence_fingerprint") @db.VarChar(64)
  model               String   @db.VarChar(80)
  advice              Json
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("action_advice_cache")
}
